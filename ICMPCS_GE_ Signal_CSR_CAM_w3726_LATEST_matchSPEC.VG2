"AND","","f(x)->{release}","=","1","","","nx","@IF@2","SQL->{col4}",""
"AND","","a2.lot","In Temp","{Sqlite (all)} : Sqlite->a0.lot","",".","c","f_lot","a2->f0.lot","SQL->{col1}"




























































































































